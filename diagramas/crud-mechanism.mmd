graph LR
    subgraph UI_Layer [User Interface]
        MainApp[MainApp / Frame]
        CatalogoPanel[CatalogoPanel / JTable]
        AutomovilForm[AutomovilForm / Fields]
    end

    subgraph Service_Layer [Business Logic]
        AutomovilService[AutomovilService]
    end

    subgraph Data_Layer [Data Access]
        AutomovilDao[AutomovilDao]
    end

    subgraph Persistence [In-Memory]
        Memory[(ArrayList<Automovil>)]
    end

    %% Flow: User Actions
    MainApp -->|inicia operacion| AutomovilService
    AutomovilForm -->|lee input/escribe estado| AutomovilService
    
    %% Flow: Service -> DAO
    AutomovilService -->|delega CRUD| AutomovilDao
    
    %% Flow: DAO -> Memory
    AutomovilDao -->|lee/escribe/actualiza| Memory
    
    %% Flow: Return path
    Memory -->|retorna datos| AutomovilDao
    AutomovilDao -->|retorna objeto/lista| AutomovilService
    AutomovilService -->|actualiza vista| MainApp
    AutomovilService -->|actualiza tabla| CatalogoPanel